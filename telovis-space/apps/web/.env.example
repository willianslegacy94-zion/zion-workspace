# URL pública do servidor Socket.io (apps/realtime)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Postgres (docker compose up -d na raiz sobe um na porta 5450)
DATABASE_URL=postgresql://postgres:postgres@localhost:5450/telovis_space

# Segredo compartilhado com apps/realtime para assinar o ticket do handshake.
# Mesmo valor nos dois .env. Gere com: openssl rand -base64 48
REALTIME_TICKET_SECRET=

# Onde o Next avisa o realtime de mudanças (remoção de membro, avatar, mesas).
# Endereço interno, visto pelo servidor Next (não pelo navegador).
REALTIME_INTERNAL_URL=http://localhost:4000

# Endereço público do app, usado nos links que saem por e-mail (convites).
APP_URL=http://localhost:3000

# Envio de e-mail (convites) pela API do Resend. Sem os dois, nada é enviado:
# o link aparece no dashboard para copiar e no log do servidor.
RESEND_API_KEY=
EMAIL_FROM="TeloVis Space <convites@seu-dominio.com>"

# Fuso (minutos em relação ao UTC) dos "dias" nas métricas. -180 = Brasília.
METRICS_TZ_OFFSET_MINUTES=-180
