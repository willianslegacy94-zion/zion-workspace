PORT=4000
# Origens do front autorizadas (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

# LiveKit (opcional — sem isso o servidor sincroniza só posição, sem mídia)
# Local (serviço livekit do docker-compose):
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=telovis-livekit-dev-secret-0123456789
# Produção/LiveKit Cloud: LIVEKIT_URL=wss://seu-projeto.livekit.cloud e as
# chaves do projeto.

# Segredo compartilhado com apps/web para validar o ticket do handshake.
# Mesmo valor nos dois .env. Gere com: openssl rand -base64 48
REALTIME_TICKET_SECRET=

# Onde o realtime entrega as métricas de uso (POST /api/internal/visits do Next).
# Endereço interno, visto pelo servidor realtime.
WEB_INTERNAL_URL=http://localhost:3000
