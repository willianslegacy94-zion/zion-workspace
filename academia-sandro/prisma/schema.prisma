// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String
  modalidade      String
  graduacaoFaixa  String
  dataMatricula   DateTime  @default(now())
  dataVencimento  DateTime?
  statusPagamento String
  aptoExame       Boolean   @default(false)

  telefone       String?
  email          String?
  dataNascimento DateTime?
  cidade         String?
  lesoes         String?

  // Override do preço padrão da modalidade pra esse aluno específico
  // (ex: 2 alunos de boxe pagando valores diferentes). null = usa ModalidadePreco.
  mensalidadeValor Decimal? @db.Decimal(10, 2)

  // Horário de referência informado no cadastro — só exibição/organização,
  // não restringe acesso (a modalidade já dá acesso a todos os horários dela).
  agendaAulaReferenciaId String?     @db.Uuid
  agendaAulaReferencia   AgendaAula? @relation(fields: [agendaAulaReferenciaId], references: [id])

  transacoes    TransacaoFinanceira[]
  presencas     PresencaDiaria[]
  matriculas    Matricula[]
  faixasExtras  AlunoFaixaModalidade[]
  usuario       Usuario?
  pacoteMembro  PacoteMembro?

  @@map("alunos")
}

model TransacaoFinanceira {
  id             String    @id @default(uuid()) @db.Uuid
  tipo           String
  categoria      String
  valor          Decimal   @db.Decimal(10, 2)
  dataTransacao  DateTime  @default(now())
  dataVencimento DateTime?
  formaPagamento String?

  comprovanteUrl       String?
  comprovanteEnviadoEm DateTime?
  gatewayPagamentoId   String?
  confirmadoEm         DateTime?

  alunoId String? @db.Uuid
  aluno   Aluno?  @relation(fields: [alunoId], references: [id])

  matriculaId String?    @db.Uuid
  matricula   Matricula? @relation(fields: [matriculaId], references: [id])

  @@map("transacoes_financeiras")
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model AgendaAula {
  id            String    @id @default(uuid()) @db.Uuid
  diaSemana     DiaSemana
  horarioInicio DateTime  @db.Time
  horarioFim    DateTime? @db.Time
  modalidade    String
  capacidadeMax Int       @default(10)
  createdAt     DateTime  @default(now())

  presencas        PresencaDiaria[]
  matriculas       Matricula[]
  alunosReferencia Aluno[]

  @@map("agenda_aulas")
}

// Matrícula do aluno num horário além da modalidade principal (Aluno.modalidade),
// que já dá acesso implícito a todos os horários daquela modalidade.
model Matricula {
  id       String   @id @default(uuid()) @db.Uuid
  criadoEm DateTime @default(now())

  // Âncora do ciclo de 12 parcelas mensais dessa modalidade extra — igual
  // Aluno.dataMatricula ancora o ciclo da mensalidade principal. Editável
  // pelo admin por modalidade (cada extra pode ter seu próprio vencimento).
  dataVencimentoBase DateTime @default(now())

  alunoId String @db.Uuid
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  agendaAulaId String     @db.Uuid
  agendaAula   AgendaAula @relation(fields: [agendaAulaId], references: [id])

  // 1 transação por mês ao longo do ciclo (não mais 1 única no ato da
  // matrícula) — mesmo padrão de "match por mês" que getParcelasCiclo já
  // usa pra mensalidade principal via Aluno.
  transacoes TransacaoFinanceira[]

  @@unique([alunoId, agendaAulaId])
  @@map("matriculas")
}

// Faixa/graduação do aluno numa modalidade extra (além da principal, cuja
// faixa fica em Aluno.graduacaoFaixa). Uma linha por modalidade extra
// praticada — não por horário, já que o aluno pode ter Matricula em mais de
// um horário da mesma modalidade extra.
model AlunoFaixaModalidade {
  id             String @id @default(uuid()) @db.Uuid
  modalidade     String
  graduacaoFaixa String

  alunoId String @db.Uuid
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, modalidade])
  @@map("aluno_faixas_modalidade")
}

enum StatusPresenca {
  AGENDADO
  CONFIRMADO
  CANCELADO
  FALTA_SEM_AVISO
}

model PresencaDiaria {
  id         String         @id @default(uuid()) @db.Uuid
  data       DateTime       @db.Date
  status     StatusPresenca @default(AGENDADO)
  observacao String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  alunoId String @db.Uuid
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  agendaAulaId String     @db.Uuid
  agendaAula   AgendaAula @relation(fields: [agendaAulaId], references: [id])

  @@unique([alunoId, agendaAulaId, data])
  @@map("presencas_diarias")
}

model Despesa {
  id                    String   @id @default(uuid()) @db.Uuid
  categoria             String
  descricao             String
  valor                 Decimal  @db.Decimal(10, 2)
  data                  DateTime
  recorrente            Boolean  @default(false)
  frequenciaRecorrencia String?
  grupoRecorrenciaId    String?  @db.Uuid
  createdAt             DateTime @default(now())

  @@map("despesas")
}

// Preço cobrado do aluno pra se matricular numa modalidade extra
// (além da modalidade principal, que já é implícita na mensalidade).
model ModalidadePreco {
  modalidade   String   @id
  valor        Decimal  @default(0) @db.Decimal(10, 2)
  atualizadoEm DateTime @updatedAt

  @@map("modalidade_precos")
}

enum TipoPacote {
  FAMILIA
  COMBO_MODALIDADES
}

// Agrupa alunos com desconto: FAMILIA (vários alunos diferentes, cada um com
// seu %) ou COMBO_MODALIDADES (um único aluno que pratica 2+ modalidades,
// desconto incide sobre mensalidade + extras somadas).
model Pacote {
  id       String     @id @default(uuid()) @db.Uuid
  nome     String
  tipo     TipoPacote
  criadoEm DateTime   @default(now())

  // Só usado por COMBO_MODALIDADES criado como catálogo (sem membro ainda,
  // pro aluno escolher no autocadastro/matrícula) — vira o
  // descontoPercentual do PacoteMembro criado quando alguém escolhe esse
  // pacote. Pacotes FAMILIA sempre nascem com membros, nunca usam este campo.
  descontoPadrao Decimal? @db.Decimal(5, 2)

  membros PacoteMembro[]

  @@map("pacotes")
}

model PacoteMembro {
  id                 String  @id @default(uuid()) @db.Uuid
  descontoPercentual Decimal @default(0) @db.Decimal(5, 2)
  // Só relevante pra Pacote.tipo = FAMILIA: quem tem login no portal e vê
  // a mensalidade de todos os integrantes na aba Financeiro dele.
  titular            Boolean @default(false)

  pacoteId String @db.Uuid
  pacote   Pacote @relation(fields: [pacoteId], references: [id], onDelete: Cascade)

  alunoId String @unique @db.Uuid
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@map("pacote_membros")
}

model PreCadastro {
  id                  String    @id @default(uuid()) @db.Uuid
  nome                String
  idade               Int?
  dataNascimento      DateTime?
  telefone            String
  email               String?
  cidade              String?
  lesoes              String?
  modalidadeInteresse String?
  status              String    @default("Pendente")
  criadoEm            DateTime  @default(now())

  // Data escolhida pelo lead pra uma aula experimental — dispara WhatsApp
  // automático pro admin (ver src/lib/whatsapp-gateway.ts).
  dataAulaExperimental DateTime? @db.Date

  // Consentimento LGPD coletado no formulário público de pré-matrícula.
  termosAceitos   Boolean   @default(false)
  termosAceitosEm DateTime?

  @@map("pre_cadastros")
}

model ConfiguracaoAgenda {
  id           String    @id @default("singleton")
  almocoInicio DateTime? @db.Time
  almocoFim    DateTime? @db.Time
  atualizadoEm DateTime  @updatedAt

  @@map("configuracao_agenda")
}

model BloqueioAgenda {
  id         String   @id @default(uuid()) @db.Uuid
  data       DateTime @db.Date
  horaInicio DateTime @db.Time
  horaFim    DateTime @db.Time
  motivo     String?
  createdAt  DateTime @default(now())

  @@map("bloqueios_agenda")
}

enum Role {
  ADMIN
  ALUNO
}

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  username         String    @unique
  email            String    @unique
  nome             String?
  telefone         String?
  pix              String?
  passwordHash     String
  role             Role      @default(ALUNO)
  senhaTemporaria  Boolean   @default(false)
  tokenRecuperacao String?
  tokenExpiracao   DateTime?
  alertasLidosEm   DateTime?
  createdAt        DateTime  @default(now())

  alunoId String? @unique @db.Uuid
  aluno   Aluno?  @relation(fields: [alunoId], references: [id])

  @@map("usuarios")
}
