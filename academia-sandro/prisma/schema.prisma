// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String
  modalidade      String
  graduacaoFaixa  String
  dataMatricula   DateTime  @default(now())
  dataVencimento  DateTime?
  statusPagamento String
  aptoExame       Boolean   @default(false)

  telefone       String?
  email          String?
  dataNascimento DateTime?
  cidade         String?
  lesoes         String?

  transacoes TransacaoFinanceira[]

  @@map("alunos")
}

model TransacaoFinanceira {
  id            String   @id @default(uuid()) @db.Uuid
  tipo          String
  categoria     String
  valor         Decimal  @db.Decimal(10, 2)
  dataTransacao DateTime @default(now())

  alunoId String? @db.Uuid
  aluno   Aluno?  @relation(fields: [alunoId], references: [id])

  @@map("transacoes_financeiras")
}

model Despesa {
  id                    String   @id @default(uuid()) @db.Uuid
  categoria             String
  descricao             String
  valor                 Decimal  @db.Decimal(10, 2)
  data                  DateTime
  recorrente            Boolean  @default(false)
  frequenciaRecorrencia String?
  grupoRecorrenciaId    String?  @db.Uuid
  createdAt             DateTime @default(now())

  @@map("despesas")
}

model PreCadastro {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String
  idade          Int?
  dataNascimento DateTime?
  telefone       String
  email          String?
  cidade         String?
  lesoes         String?
  status         String    @default("Pendente")
  criadoEm       DateTime  @default(now())

  @@map("pre_cadastros")
}

model Usuario {
  id                String    @id @default(uuid()) @db.Uuid
  username          String    @unique
  email             String    @unique
  passwordHash      String
  senhaTemporaria   Boolean   @default(false)
  tokenRecuperacao  String?
  tokenExpiracao    DateTime?
  createdAt         DateTime  @default(now())

  @@map("usuarios")
}
