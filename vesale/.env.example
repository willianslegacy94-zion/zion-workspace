# PostgreSQL (local via Docker)
DATABASE_URL="postgresql://vesale:vesale@localhost:5437/vesale"

# NextAuth
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Claude API — fallback de extração de nota fiscal (PDF/DANFE ou XML fora do
# padrão SEFAZ, RF-016). Só é chamada quando o parser XML determinístico
# (RF-015) não reconhece o arquivo; sem esta chave, notas nesse caso ficam
# marcadas como ERRO em vez de conciliadas automaticamente.
ANTHROPIC_API_KEY=""

# Seed inicial — usuário gestor
GESTOR_NOME="Gestor Vesale"
GESTOR_EMAIL="gestor@vesale.local"
GESTOR_SENHA="troque-esta-senha"

# Seed inicial — usuário operador de caixa
OPERADOR_NOME="Operador Balcão"
OPERADOR_EMAIL="operador@vesale.local"
OPERADOR_SENHA="troque-esta-senha"

# Postgres (usado pelo docker-compose.yml)
POSTGRES_USER="vesale"
POSTGRES_PASSWORD="vesale"
POSTGRES_DB="vesale"
